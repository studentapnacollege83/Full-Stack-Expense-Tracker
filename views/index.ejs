
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Expense Tracker</title>
  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-slate-100">
 
<nav class="border-b border-white/10 bg-slate-900/80 shadow-sm backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <div>
      <h1 class="text-2xl font-bold text-indigo-400">
        Expense Tracker
      </h1>
      <p class="mt-1 text-sm text-slate-400">
        Manage your money
      </p>
    </div>

    <div class="flex items-center gap-3">
      <% if (currentUser) { %>
        <span class="hidden text-sm font-medium text-slate-300 sm:block">
          Welcome back, <%= currentUser.name %>!
        </span>
      <% } %>

      <% if (isLoggedIn) { %>
        <form action="/logout" method="POST">
          <button
            type="submit"
          class="rounded-lg bg-red-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-400"
          >
            Logout
          </button>
        </form>
      <% } else { %>
        <a
          href="/login"
          class="rounded-lg px-4 py-2 text-sm font-semibold text-slate-300 hover:bg-white/10"
        >
          Login
        </a>

        <a
          href="/signup"
          class="rounded-lg bg-indigo-500 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-400"
        >
          Sign Up
        </a>
      <% } %>
    </div>
  </div>
</nav>


  <main class="mx-auto max-w-7xl px-6 py-8">
    <div class="mb-8">
      <h2 class="text-3xl font-bold">Dashboard</h2>
      <p class="mt-2 text-slate-400">
        Track your income and expenses in one place.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="rounded-xl border border-white/10 bg-slate-900 p-6 shadow-lg shadow-black/20">
        <p class="text-sm text-slate-400">Total Balance</p>
        <h3 class="mt-3 text-3xl font-bold">
  ₹<%= balance.toLocaleString("en-IN") %>
</h3>
      </div>

      <div class="rounded-xl border border-white/10 bg-slate-900 p-6 shadow-lg shadow-black/20">
        <p class="text-sm text-slate-400">Total Income</p>
        <h3 class="mt-3 text-3xl font-bold text-emerald-400">
  ₹<%= totalIncome.toLocaleString("en-IN") %>
</h3>
      </div>

      <div class="rounded-xl border border-white/10 bg-slate-900 p-6 shadow-lg shadow-black/20">
        <p class="text-sm text-slate-400">Total Expenses</p>
        <h3 class="mt-3 text-3xl font-bold text-rose-400">
  ₹<%= totalExpenses.toLocaleString("en-IN") %>
</h3>
      </div>
    </div>
   
<section class="mt-8 rounded-xl border border-white/10 bg-slate-900 p-6 shadow-lg shadow-black/20">
  <h3 class="text-xl font-bold">Add Transaction</h3>

  <form action="/transactions/add" method="POST"
        class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">

    <div>
      <label for="title" class="mb-2 block text-sm font-medium">
        Transaction Title
      </label>
      <input
        type="text"
        id="title"
        name="title"
        placeholder="e.g. Monthly pocket money"
        required
        class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
      >
    </div>

    <div>
      <label for="amount" class="mb-2 block text-sm font-medium">
        Amount (₹)
      </label>
      <input
        type="number"
        id="amount"
        name="amount"
        placeholder="Enter amount"
        min="0.01"
        max="10000000"
        step="0.01"
        required
        class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
      >
    </div>

    <div>
      <label for="transactionType" class="mb-2 block text-sm font-medium">
        Transaction Type
      </label>
      <select
        id="transactionType"
        name="transactionType"
        required
        class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
      >
        <option value="">Select type</option>
        <option value="income">Income</option>
        <option value="expense">Expense</option>
      </select>
    </div>

    <div>
      <label for="category" class="mb-2 block text-sm font-medium">
        Category
      </label>
      <select
        id="category"
        name="category"
        required
        class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
      >
        <option value="">Select category</option>
        <option value="Food">Food</option>
        <option value="Travel">Travel</option>
        <option value="Shopping">Shopping</option>
        <option value="Education">Education</option>
        <option value="Salary">Salary</option>
        <option value="Pocket Money">Pocket Money</option>
        <option value="Other">Other</option>
      </select>
    </div>

    <div>
      <label for="date" class="mb-2 block text-sm font-medium">
        Date
      </label>
      <input
        type="date"
        id="date"
        name="date"
        required
        class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
      >
    </div>

    <div class="flex items-end">
      <button
        type="submit"
        class="w-full rounded-lg bg-indigo-500 px-5 py-3 font-semibold text-white transition hover:bg-indigo-400"
      >
        Add Transaction
      </button>
    </div>

  </form>
</section>

    
<section class="mt-8 rounded-xl border border-white/10 bg-slate-900 p-6 shadow-lg shadow-black/20">
  <h3 class="text-xl font-bold">Recent Transactions</h3>

  <% if (transactions.length === 0) { %>
    <p class="mt-3 text-slate-400">
      No transactions yet. Add your first transaction!
    </p>
  <% } else { %>

    <div class="mt-5 overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-white/10 text-sm text-slate-400">
            <th class="px-4 py-3">Title</th>
            <th class="px-4 py-3">Category</th>
            <th class="px-4 py-3">Date</th>
            <th class="px-4 py-3">Type</th>
            <th class="px-4 py-3 text-right">Amount</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% transactions.forEach((transaction) => { %>
            <tr class="border-b border-white/10 last:border-0 hover:bg-white/5">
              <td class="px-4 py-4 font-medium">
                <%= transaction.title %>
              </td>

              <td class="px-4 py-4 text-slate-400">
                <%= transaction.category %>
              </td>

              <td class="px-4 py-4 text-slate-400">
                <%= new Date(transaction.date).toLocaleDateString("en-IN") %>
              </td>

              <td class="px-4 py-4">
                <% if (transaction.transactionType === "income") { %>
                  <span class="rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-emerald-300">
                    Income
                  </span>
                <% } else { %>
                  <span class="rounded-full bg-rose-500/15 px-3 py-1 text-xs font-semibold text-rose-300">
                    Expense
                  </span>
                <% } %>
              </td>

              <td class="px-4 py-4 text-right font-semibold <%= transaction.transactionType === 'income' ? 'text-emerald-400' : 'text-rose-400' %>">
                <%= transaction.transactionType === "income" ? "+" : "-" %>₹<%= Number(transaction.amount).toLocaleString("en-IN") %>
              </td>
              
<td class="px-4 py-4 text-right">
  <div class="flex justify-end gap-2">
    <a
      href="/transactions/edit/<%= transaction._id %>"
      class="rounded-md bg-indigo-500/15 px-3 py-2 text-sm font-medium text-indigo-300 hover:bg-indigo-500/25"
    >
      Edit
    </a>

    <form
      action="/transactions/delete/<%= transaction._id %>"
      method="POST"
      onsubmit="return confirm('Are you sure you want to delete this transaction?')"
    >
      <button
        type="submit"
        class="rounded-md bg-rose-500/15 px-3 py-2 text-sm font-medium text-rose-300 hover:bg-rose-500/25"
      >
        Delete
      </button>
    </form>
  </div>
</td>

            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  <% } %>
</section>

  </main>
</body>
</html>
