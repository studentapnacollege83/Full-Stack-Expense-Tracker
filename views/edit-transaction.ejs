
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Transaction</title>
  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-slate-100">
  <main class="mx-auto max-w-2xl px-6 py-10">
    <section class="rounded-xl border border-white/10 bg-slate-900 p-6 shadow-lg shadow-black/20">
      <h1 class="text-2xl font-bold">Edit Transaction</h1>
      <p class="mt-2 text-slate-400">Update your transaction details.</p>

      <form
        action="/transactions/update/<%= transaction._id %>"
        method="POST"
        class="mt-6 space-y-5"
      >
        <div>
          <label for="title" class="mb-2 block text-sm font-medium">Title</label>
          <input
            id="title"
            name="title"
            type="text"
            value="<%= transaction.title %>"
            required
            class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
          >
        </div>

        <div>
          <label for="amount" class="mb-2 block text-sm font-medium">Amount (₹)</label>
          <input
            id="amount"
            name="amount"
            type="number"
            min="0.01"
            step="0.01"
            value="<%= transaction.amount %>"
            required
            class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
          >
        </div>

        <div>
          <label for="transactionType" class="mb-2 block text-sm font-medium">Type</label>
          <select
            id="transactionType"
            name="transactionType"
            required
            class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
          >
            <option value="income" <%= transaction.transactionType === "income" ? "selected" : "" %>>Income</option>
            <option value="expense" <%= transaction.transactionType === "expense" ? "selected" : "" %>>Expense</option>
          </select>
        </div>

        <div>
          <label for="category" class="mb-2 block text-sm font-medium">Category</label>
          <select
            id="category"
            name="category"
            required
            class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
          >
            <% ["Food", "Travel", "Shopping", "Education", "Salary", "Pocket Money", "Other"].forEach((category) => { %>
              <option value="<%= category %>" <%= transaction.category === category ? "selected" : "" %>>
                <%= category %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="date" class="mb-2 block text-sm font-medium">Date</label>
          <input
            id="date"
            name="date"
            type="date"
            value="<%= new Date(transaction.date).toISOString().slice(0, 10) %>"
            required
            class="w-full rounded-lg border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20"
          >
        </div>

        <div class="flex gap-3">
          <button
            type="submit"
            class="rounded-lg bg-indigo-500 px-5 py-3 font-semibold text-white transition hover:bg-indigo-400"
          >
            Save Changes
          </button>

          <a
            href="/"
            class="rounded-lg bg-slate-700 px-5 py-3 font-semibold text-slate-100 transition hover:bg-slate-600"
          >
            Cancel
          </a>
        </div>
      </form>
    </section>
  </main>
</body>
</html>
